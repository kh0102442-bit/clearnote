const quizBox = document.getElementById('quiz');
let answers = STORE.get('answers', {});
let lastPart = '';

function renderQuiz(){
  quizBox.innerHTML = '';
  lastPart = '';
  QUESTIONS.forEach(item => {
    if(item.part !== lastPart){
      lastPart = item.part;
      const h = document.createElement('div');
      h.className = 'parttitle';
      h.innerHTML = item.part;
      quizBox.appendChild(h);
    }

    const card = document.createElement('div');
    card.className = 'qcard';
    card.id = 'q' + item.n;

    let html = `
      <div class="qhead">
        <div class="qnum">${item.n}</div>
        <span class="chip">${item.topic}</span>
        <span class="chip">${item.type === 'tf' ? 'T/F' : 'MCQ'}</span>
      </div>
      <p class="qtext">${item.q}</p>
    `;

    if(item.type === 'mcq'){
      html += '<div class="opts">';
      item.options.forEach((op, i) => {
        html += `<div class="opt" data-q="${item.n}" data-i="${i}">
                   <span class="mk"></span><span class="otxt">${op}</span></div>`;
      });
      html += '</div>';
    } else if(item.type === 'tf'){
      html += '<div class="opts">';
      ['True','False'].forEach((op, i) => {
        html += `<div class="opt" data-q="${item.n}" data-i="${i}">
                   <span class="mk"></span><span class="otxt">${op}</span></div>`;
      });
      html += '</div>';
    }

    html += `
      <div class="qacts">
        <button class="btn o" data-hint="${item.n}">💡 Hint</button>
        <button class="btn p" data-check="${item.n}">✓ Check</button>
      </div>
      <div class="fb" id="fb${item.n}"></div>
    `;

    card.innerHTML = html;
    quizBox.appendChild(card);
  });

  // Restore previous answers
  Object.keys(answers).forEach(qn => {
    const a = answers[qn];
    if(!a) return;
    const q = QUESTIONS.find(x => x.n === +qn);
    if(!q) return;

    const opts = document.querySelectorAll(`.opt[data-q="${qn}"]`);
    opts.forEach(o => {
      const i = +o.dataset.i;
      if(i === a.value) o.classList.add('sel');
      if(a.checked){
        o.classList.add('lock');
        if(i === q.ans) o.classList.add('right');
        else if(i === a.value) o.classList.add('wrong');
      }
    });

    if(a.checked){
      const fb = document.getElementById('fb' + qn);
      if(fb){
        fb.className = 'fb ' + (a.correct ? 'ok show' : 'no show');
        fb.innerHTML = `<span class="ttl">${a.correct ? '✅ Correct' : '❌ Incorrect'}</span>${q.explain}<span class="trap"><b>⚠️ Exam Trap:</b> ${q.trap}</span>`;
      }
    }
  });

  attachEvents();
  updateProgress();
}

function attachEvents(){
  quizBox.querySelectorAll('.opt').forEach(el => {
    el.addEventListener('click', () => {
      const qn = +el.dataset.q;
      if(answers[qn] && answers[qn].checked) return;
      const siblings = el.parentElement.querySelectorAll('.opt');
      siblings.forEach(s => s.classList.remove('sel'));
      el.classList.add('sel');
      answers[qn] = { value: +el.dataset.i, checked: false, correct: null };
      STORE.set('answers', answers);
      updateProgress();
    });
  });

  quizBox.querySelectorAll('[data-hint]').forEach(btn => {
    btn.addEventListener('click', () => {
      const qn = +btn.dataset.hint;
      const q = QUESTIONS.find(x => x.n === qn);
      const fb = document.getElementById('fb' + qn);
      fb.className = 'fb hint show';
      fb.innerHTML = '<span class="ttl">💡 Conceptual Hint</span>' + q.hint;
    });
  });

  quizBox.querySelectorAll('[data-check]').forEach(btn => {
    btn.addEventListener('click', () => checkOne(+btn.dataset.check));
  });
}

function checkOne(qn){
  const q = QUESTIONS.find(x => x.n === qn);
  const fb = document.getElementById('fb' + qn);
  const a = answers[qn];

  if(!a || a.value === undefined){
    fb.className = 'fb hint show';
    fb.innerHTML = '<span class="ttl">⚠️ Notice</span> You have not chosen an answer yet.';
    return;
  }

  const correct = (a.value === q.ans);

  const opts = document.querySelectorAll(`.opt[data-q="${qn}"]`);
  opts.forEach(o => {
    o.classList.add('lock');
    const i = +o.dataset.i;
    if(i === q.ans) o.classList.add('right');
    else if(i === a.value) o.classList.add('wrong');
  });

  answers[qn] = { value: a.value, checked: true, correct };
  STORE.set('answers', answers);

  if(correct){
    fb.className = 'fb ok show';
    fb.innerHTML = `<span class="ttl">✅ Correct</span>${q.explain}<span class="trap"><b>⚠️ Exam Trap:</b> ${q.trap}</span>`;
  } else {
    fb.className = 'fb no show';
    fb.innerHTML = `<span class="ttl">❌ Incorrect</span>${q.explain}<span class="trap"><b>⚠️ Exam Trap:</b> ${q.trap}</span>`;
  }
  updateProgress();
}

/* ============================================================
   5) PROGRESS / GRADE ALL / RESET
   ============================================================ */
const AUTO_TOTAL = QUESTIONS.length;

function updateProgress(){
  const done = Object.values(answers).filter(a => a && a.checked).length;
  document.getElementById('progTxt').textContent = done + ' / ' + AUTO_TOTAL;
  document.getElementById('progBar').style.width = (done / AUTO_TOTAL * 100) + '%';
}

document.getElementById('gradeAllBtn').addEventListener('click', () => {
  QUESTIONS.forEach(q => {
    const a = answers[q.n];
    if(!a || !a.checked) checkOne(q.n);
  });
  window.scrollTo({top:0, behavior:'smooth'});
});

document.getElementById('resetAllBtn').addEventListener('click', () => {
  if(!confirm('Reset all answers and start over?')) return;
  answers = {};
  STORE.del('answers');
  renderQuiz();
  window.scrollTo({top:0, behavior:'smooth'});
});

/* ============================================================
   6) INIT
   ============================================================ */
renderQuiz();
</script>
</body>
